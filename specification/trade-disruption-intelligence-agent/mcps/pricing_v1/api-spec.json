  "tags": [
    {
      "name": "pricing",
      "description": "Pricing API for Product Sourcing Price Information"
    },
    {
      "name": "Extract the Pricing Data Rest API",
      "description": "The Extract Pricing Data API enables you to retrieve all changes and additions to the product sourcing pricing database within a 24-hour time range."
    }
  ],
  "produces": [
    "application/json",
    "application/xml"
  ],
  "paths": {
    "/objects": {
      "get": {
        "tags": [
          "Extract Pricing Data API"
        ],
        "summary": "Return the required pricing information from your realm",
        "description": "Get the pricing information from your realm either in JSON or XML format",
        "operationId": "GetDetails",
        "parameters": [
          {
            "name": "realm",
            "in": "query",
            "description": "Unique identifier of the realm. \n Example: s4All",
            "required": true,
            "type": "string"
          },
          {
            "name": " $filter",
            "in": "query",
            "description": "$filter=expression. ‘expression’ is a combination of resource parameters,$filter=expression. ‘expression’ is a combination of resource parameters, values. Operator ‘eq’ and 'in' is used to link parameter and value. Operator ‘and’ is used to link two or more parameters. For example, $filter=a eq ‘b’ and c eq 'd’. Following parameters are supported in current implementation.\n objectType(optional) \n fromDate(required) \n toDate(required) \nThe date should use the yyyy-MM-dd'T'HH:mm:ssX ISO_OFFSET_DATE_TIME date format. ex:- 2018-01-01T23:59:59-08:00  \nPricing DB objectType: RFX,RFXItem,RFXItemSupplier,RFXStandardTerm,RFXCustomTerm,Item,ItemPrice,ItemAMLSplit,Bom,AML,ItemAttribute,BomSplit,ItemPlant,\nItemProgram,Plant,Program,LeadTime,CustomFields,ItemTags,BomTags.\n\nValid  combinations are \n1. fromDate eq '2020-02-12T00:58:15-08:00' and toDate eq '2020-02-12T23:58:15-08:00' (return all ObjectTypes) \n2. objectType eq 'item' and fromdate eq '2020-02-12T00:58:15-08:00' and todate eq '2020-02-12T23:58:15-08:00'\n3. objectType in ('Item', 'RFX', 'Bom', 'Plant') and fromdate eq '2020-02-12T00:58:15-08:00' and todate eq '2020-02-12T23:58:15-08:00'\n \n Example: objectType in (ItemPrice, bom) and fromdate eq '2020-04-29T09:30:00-08:00' and todate eq '2020-04-29T21:50:00-08:00' ",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful",
            "schema": {
              "$ref": "#/definitions/WsResponse"
            }
          },
          "400": {
            "description": "Your request is not processed becuase of an error on server side",
            "schema": {
              "$ref": "#/definitions/BadRequest"
            }
          },
          "401": {
            "description": "Unauthorized request. Check oauth token is expired or you are not using correct oauth token.",
            "schema": {
              "$ref": "#/definitions/Unauthorized"
            }
          },
          "403": {
            "description": "you are not able to connect because of proxy or network issue",
            "schema": {
              "$ref": "#/definitions/Forbidden"
            }
          },
          "404": {
            "description": "the URL you requested does not exist",
            "schema": {
              "$ref": "#/definitions/NotFound"
            }
          },
          "500": {
            "description": "If your URL is not constructed properly, you have trailing spaces in URL, or ARIBA site is temporarily down",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      }
    }
  },
