  "info": {
    "version": "1.0.0",
    "title": "Pricing API for Product Sourcing Price Information",
    "description": "This Pricing Data API enables you to retrieve all changes incurred in Product Sourcing database for the specified timerange upto 24-hours. Changes includes BOM, Items, AML, Prices, Splits, RFx, RFxItem, RFxItemSupplier, RFxStandardTerm, RFxCustomTerm, ItemPrice, ItemAMLSplit, ItemAttribute, BOMSplits, ItemPlant, ItemProgram, Plant,Program, LeadTime, CustomFields, ItemTags, BomTags."
  },
  "x-sap-stateInfo": {
    "state": "Active"
  },
  "x-sap-shortText": "API for extracting the price information from Direct Material Sourcing (DMS)",
  "host": "sandbox.api.sap.com",
  "basePath": "/ariba/api/pricing/v1/sandbox",
  "schemes": [
    "https"
  ],
  "x-sap-ext-overview": [
    {
      "name": "API Group",
      "values": [
        "Strategic Sourcing"
      ]
    },
    {
      "name": "API System Role",
      "values": [
        "SAP Ariba Sourcing"
      ]
    },
    {
      "name": "Datacenters",
      "values": [
        "US",
        "EU",
        "RU",
        "UAE",
        "KSA",
        "CN",
        "AU",
        "JP"
      ]
    }
  ],
